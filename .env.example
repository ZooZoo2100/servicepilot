PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=var/servicepilot.sqlite
# simulation never calls a paid API. Live mode requires explicit configuration.
AGENT_PROVIDER=simulation
MAX_DAILY_MODEL_CALLS=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Set a long unique token before exposing the operations interface.
ADMIN_TOKEN=
# Explicitly allow fictional identity selection. Never use for real customer data.
DEMO_MODE=true

# Paid evaluation is opt-in, separate from ordinary development.
ALLOW_PAID_EVALS=false
# Required for --live, global across all scenarios (hard ceiling 250).
MAX_LIVE_EVAL_CALLS=10

# Public Vercel demo only: encrypts temporary session state, never sent to the browser.
PUBLIC_DEMO=false
DEMO_SESSION_SECRET=
